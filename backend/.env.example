# Django
SECRET_KEY=change-me
DEBUG=false
ALLOWED_HOSTS=geomap.krasrm.com,localhost

# Ключ, которым бот подписывает запросы на запись
BOT_API_KEY=change-me-too

# Postgres (необязательно — без этих переменных используется sqlite)
POSTGRES_DB=geomap
POSTGRES_HOST=geomap_db
POSTGRES_USER=geomap
POSTGRES_PORT=5432
POSTGRES_PASS=geomap

# MinIO — переиспользуем тот же инстанс, что и rmc_rest_api (services: files)
MINIO_ENDPOINT=files:9000
MINIO_STORAGE_ACCESS_KEY=
MINIO_STORAGE_SECRET_KEY=
MINIO_HTTPS=false
MINIO_EXTERNAL_ENDPOINT=192.168.0.8:9000
MINIO_EXTERNAL_HTTPS=false
MINIO_REGION=us-east-1
